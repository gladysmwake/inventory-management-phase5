    {
      "name": "9. GET Lookup by Barcode (OpenFoodFacts)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:5000/lookup/barcode/3017624010701",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
