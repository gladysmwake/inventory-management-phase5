    {
      "name": "10. GET Search by Name (OpenFoodFacts)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:5000/lookup/search?name=nutella",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "5000",
          "path": ["lookup", "search"],
          "query": [
            {
              "key": "name",
              "value": "nutella"
            }
          ]
        }
      }
    },
    {
      "name": "11. POST Enrich Item (OpenFoodFacts)",
      "request": {
        "method": "POST",
        "header": [],
